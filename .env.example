# QUANT_INDUSTRY_V1 Environment Configuration
# Copy this file to .env and fill in your values

# ====================
# Environment
# ====================
QUANT_ENV=development  # development, staging, production
QUANT_DEBUG=false
QUANT_LOG_LEVEL=INFO

# ====================
# Database
# ====================
# QUANT_DB_PATH=/path/to/custom/quant.db  # Optional, uses default if not set

# ====================
# Trading Mode
# ====================
QUANT_TRADING_MODE=paper  # backtest, paper, live

# ====================
# Alpaca API (Required for paper/live trading)
# ====================
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Use https://api.alpaca.markets for live

# ====================
# Optional: Polygon API
# ====================
# POLYGON_API_KEY=your_polygon_key

# ====================
# Risk Controls
# ====================
# MAX_DAILY_LOSS_PCT=0.05
# MAX_POSITION_PCT=0.20
# MAX_DRAWDOWN_PCT=0.15
