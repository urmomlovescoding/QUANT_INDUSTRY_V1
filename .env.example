# QUANT INDUSTRY V1 - Environment Configuration
# Copy this to .env and fill in your API keys

# ============== DATA PROVIDERS ==============
# Get free keys at: https://alpaca.markets (recommended - stocks + crypto)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here

# Get free key at: https://polygon.io (stocks, options, forex, crypto)
POLYGON_API_KEY=your_polygon_key_here

# ============== BROKER CONNECTIONS ==============
# Interactive Brokers (requires TWS or Gateway running)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ============== DATABASE ==============
DATABASE_URL=postgresql://localhost:5432/quant_industry
REDIS_URL=redis://localhost:6379

# ============== API SETTINGS ==============
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ============== ALERTS ==============
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
