# =============================================================================
# QUANT INDUSTRY - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Do NOT commit your .env file to version control.
#
# When no API keys are configured, the system automatically uses yfinance
# for free market data (no API key required).
# =============================================================================

# -- Data Source ---------------------------------------------------------------
# Which market data provider to use: "alpaca", "polygon", "yfinance" (default)
# yfinance is free and requires no API key.
DATA_SOURCE=yfinance

# -- Alpaca Markets (https://alpaca.markets) -----------------------------------
# Sign up for free paper trading keys at https://app.alpaca.markets/signup
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Use paper trading URL by default; switch to live when ready:
# ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# -- Polygon.io (https://polygon.io) ------------------------------------------
POLYGON_API_KEY=

# -- Tradier (https://tradier.com) --------------------------------------------
TRADIER_API_KEY=
TRADIER_ACCOUNT_ID=
# Set to "false" for production
TRADIER_SANDBOX=true
TRADIER_BASE_URL=https://sandbox.tradier.com

# -- Finnhub (https://finnhub.io) ---------------------------------------------
FINNHUB_API_KEY=

# -- FINRA (https://developer.finra.org) --------------------------------------
FINRA_API_KEY=

# -- NewsAPI (https://newsapi.org) ---------------------------------------------
NEWS_API_KEY=

# -- Alpha Vantage (https://www.alphavantage.co) ------------------------------
ALPHA_VANTAGE_API_KEY=

# -- Financial Modeling Prep (https://financialmodelingprep.com) ---------------
FMP_API_KEY=

# -- Authentication ------------------------------------------------------------
# IMPORTANT: Change this to a strong random secret in production!
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -- Database ------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/quant.db

# -- Server --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# -- Alerts (optional) --------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
