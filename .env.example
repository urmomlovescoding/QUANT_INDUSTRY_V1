# ===========================================
# QUANT INDUSTRY v10.0 - Environment Configuration
# ===========================================
# Copy this to .env and fill in your API keys
# NEVER commit .env to version control!
# ===========================================

# ============== BROKER API KEYS ==============
# Get free keys at: https://alpaca.markets (recommended - stocks + crypto)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Tradier (options data)
TRADIER_API_KEY=
TRADIER_ACCOUNT_ID=
TRADIER_BASE_URL=https://sandbox.tradier.com
TRADIER_SANDBOX=true

# ============== DATA PROVIDER KEYS ==============
# Get free key at: https://polygon.io (stocks, options, forex, crypto)
POLYGON_API_KEY=

# Finnhub (real-time market data)
FINNHUB_API_KEY=

# FINRA (short interest, dark pool data)
FINRA_API_KEY=

# NewsAPI (market news & sentiment)
NEWS_API_KEY=

# Alpha Vantage (fundamental data)
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep
FMP_API_KEY=

# ============== BROKER CONNECTIONS ==============
# Interactive Brokers (requires TWS or Gateway running)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ============== AUTHENTICATION ==============
# IMPORTANT: Generate a strong random key for production!
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-256-bit-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to "true" to enforce JWT auth on ALL POST/PUT/DELETE endpoints
# When "false", only critical endpoints (kill switch, orders, API keys) require auth
AUTH_REQUIRED=false

# ============== DATABASE ==============
DATABASE_URL=postgresql://localhost:5432/quant_industry
REDIS_URL=redis://localhost:6379

# Docker Compose passwords (REQUIRED for docker-compose up)
DB_PASSWORD=
GRAFANA_PASSWORD=

# ============== API SETTINGS ==============
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ============== ALERTS ==============
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
