# QUANT INDUSTRY V1 - Environment Configuration
# Copy this to .env and fill in your API keys
#
# SECURITY WARNING: Never commit .env files with real credentials!
# This file should be in .gitignore

# ============== BROKER / DATA PROVIDERS ==============

# Alpaca Markets - Primary broker for stocks + crypto
# Get free keys at: https://alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Tradier - Alternative broker for options
# Get keys at: https://developer.tradier.com
TRADIER_API_KEY=
TRADIER_ACCOUNT_ID=
TRADIER_SANDBOX=true
TRADIER_BASE_URL=https://sandbox.tradier.com

# Polygon.io - Market data (stocks, options, forex, crypto)
# Get free key at: https://polygon.io
POLYGON_API_KEY=

# Finnhub - Real-time quotes and news
# Get free key at: https://finnhub.io
FINNHUB_API_KEY=

# FINRA - Regulatory data
# Get key at: https://developer.finra.org
FINRA_API_KEY=

# NewsAPI - News sentiment
# Get key at: https://newsapi.org
NEWS_API_KEY=

# Alpha Vantage - Alternative market data
# Get free key at: https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep - Fundamentals
# Get key at: https://financialmodelingprep.com
FMP_API_KEY=

# ============== BROKER CONNECTIONS ==============

# Interactive Brokers (requires TWS or Gateway running)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ============== DATABASE ==============
DATABASE_URL=postgresql://localhost:5432/quant_industry
REDIS_URL=redis://localhost:6379

# ============== API SETTINGS ==============
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ============== ALERTS ==============
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============== TRADING SAFETY ==============
# Set to "true" to allow live trading (default: false for safety)
ALLOW_LIVE_TRADING=false
